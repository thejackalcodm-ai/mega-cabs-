# Copy to .env and fill in your Supabase project values (Project Settings → API).
# Both are safe for the browser: the URL and the PUBLISHABLE (sb_publishable_…) key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: shows the one-click demo login panel. Leave empty/false in production.
VITE_ENABLE_DEMO_LOGIN=

# ---- Only for `npm run seed` / `npm run verify:live` on your own machine. --------------
# Never prefix these with VITE_, never add them to Vercel, never commit them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
