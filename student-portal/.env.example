# ---- Frontend (safe to expose; shipped to the browser) -----------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or, on older projects, the legacy "anon" JWT key.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Shows the one-click demo login panel. Leave false/empty in production.
VITE_ENABLE_DEMO_LOGIN=false

# ---- Seed script ONLY (never prefix with VITE_, never add to Vercel) -----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_...) or the legacy "service_role" JWT key. Keep it on your machine.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
